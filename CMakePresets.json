{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/clang-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-test",
      "displayName": "Clang Unit Tests",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UNIT_TEST": true
      }
    },
    {
      "name": "clang-asan",
      "displayName": "Clang Address and Undefined Behavior Sanitizers",
      "inherits": "clang-test",
      "cacheVariables": {
        "CUTIL_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "clang-tidy",
      "displayName": "Clang Static Analysis",
      "inherits": "clang-test",
      "cacheVariables": {
        "CUTIL_ENABLE_CLANG_TIDY": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "clang-test",
      "configurePreset": "clang-test",
      "targets": [
        "cutil_unit"
      ]
    },
    {
      "name": "clang-asan",
      "configurePreset": "clang-asan",
      "targets": [
        "cutil_unit"
      ]
    },
    {
      "name": "clang-tidy",
      "configurePreset": "clang-tidy",
      "targets": [
        "cutil_unit"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "clang-test",
      "configurePreset": "clang-test",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-asan",
      "configurePreset": "clang-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
